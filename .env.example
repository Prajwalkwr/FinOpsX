# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# PostgreSQL. For the embedded local database started by `npm run db:embedded`:
DATABASE_URL=postgresql://finopsx:finopsx_demo@127.0.0.1:5433/finopsx

# Optional. The app degrades clearly when Redis is absent.
REDIS_URL=redis://127.0.0.1:6379

# Set to true on the hosted demo so the login page can list the synthetic accounts.
SHOW_DEMO_ACCOUNTS=

# Required in production. Development uses a logged warning and local defaults when these are empty.
JWT_SECRET=
JWT_REFRESH_SECRET=

# mock | openai. Missing keys always fall back to the mock provider.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional SMTP. When unset, email delivery stays disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@finopsx.demo

# Full demo scale is 50000. Lower this if you want a faster first seed.
SEED_TRANSACTION_COUNT=20000

VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
