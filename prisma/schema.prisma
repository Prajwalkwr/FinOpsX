generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  LOCKED
  DEACTIVATED
}

enum RoleName {
  SUPER_ADMIN
  OPERATIONS_MANAGER
  ANALYST
  ENGINEER
  AUDITOR
}

enum TxStatus {
  SUCCESS
  FAILED
  PENDING
  CANCELLED
  REFUNDED
  INITIATED
  PROCESSING
  REVERSED
  SETTLED
}

enum PaymentMethod {
  QR
  WALLET
  BANK_TRANSFER
  CARD
  ACCOUNT_PAYMENT
}

enum FailureReason {
  TIMEOUT
  BANK_API_ERROR
  INSUFFICIENT_FUNDS
  NETWORK_ERROR
  INVALID_REQUEST
  SERVICE_UNAVAILABLE
  DUPLICATE_TRANSACTION
  AUTHENTICATION_FAILURE
  SETTLEMENT_DELAY
}

enum SettlementStatus {
  NOT_STARTED
  QUEUED
  SETTLED
  DELAYED
  FAILED
}

enum SettlementBatchStatus {
  PENDING
  PROCESSING
  SETTLED
  DELAYED
  FAILED
}

enum DeliveryState {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  INVESTIGATING
  IDENTIFIED
  MITIGATING
  RESOLVED
  POST_INCIDENT_REVIEW
  ACKNOWLEDGED
}

enum AnomalyType {
  HIGH_VALUE_SPIKE
  TRANSACTION_VOLUME_SPIKE
  REPEATED_FAILURE
  API_LATENCY_SPIKE
  MERCHANT_VOLUME_SPIKE
  FAILURE_RATE_SPIKE
  SETTLEMENT_DELAY
  UNUSUAL_TIME_ACTIVITY
  INSTITUTION_ACTIVITY
}

enum AnomalyStatus {
  DETECTED
  REVIEW
  CONFIRMED
  DISMISSED
  RESOLVED
}

enum ServiceStatus {
  OPERATIONAL
  DEGRADED
  INCIDENT
  MAINTENANCE
}

enum ReportType {
  DAILY_OPERATIONS
  TRANSACTION_SUMMARY
  INSTITUTION_PERFORMANCE
  INCIDENT_REPORT
  ANOMALY_REPORT
  SYSTEM_HEALTH
  RECONCILIATION_REPORT
}

enum ReportCadence {
  DAILY
  WEEKLY
  MONTHLY
}

enum ReconStatus {
  MATCHED
  MISMATCH
  INVESTIGATING
  RESOLVED
}

enum ReconIssue {
  MISSING_AT_INSTITUTION
  MISSING_ON_PLATFORM
  AMOUNT_MISMATCH
  NOT_SETTLED
}

enum JobType {
  EOD_SETTLEMENT
  TRANSACTION_RECONCILIATION
  DAILY_REPORT
  DATA_VALIDATION
  BACKUP_SIMULATION
  SETTLEMENT_VALIDATION
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum DqType {
  MISSING_MERCHANT_REFERENCE
  DUPLICATE_CORRELATION_ID
  INVALID_CUSTOMER_ID
  MISSING_RESPONSE_CODE
  MISSING_FAILURE_REASON
  DELAYED_SETTLEMENT
  MISSING_LEDGER_RECORD
}

enum DqStatus {
  OPEN
  INVESTIGATING
  RESOLVED
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String
  users       User[]
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  passwordHash      String
  name              String
  roleId            String
  role              Role       @relation(fields: [roleId], references: [id])
  status            UserStatus @default(ACTIVE)
  failedLoginCount  Int        @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  timezone          String     @default("Asia/Kathmandu")
  theme             String     @default("system")
  notifyIncidents   Boolean    @default(true)
  notifyAnomalies   Boolean    @default(true)
  notifyReports     Boolean    @default(true)
  notifySecurity    Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  refreshTokens     RefreshToken[]
  passwordResets    PasswordReset[]
  notifications     Notification[]
  conversations     AiConversation[]
  auditLogs         AuditLog[]
  assignedIncidents Incident[]          @relation("Assignee")
  reports           Report[]
  reviewedAnomalies Anomaly[]           @relation("AnomalyReviewer")
  aiQueries         AiQuery[]
  reconciliations   ReconciliationRun[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Institution {
  id                      String                   @id @default(cuid())
  name                    String
  code                    String                   @unique
  type                    String
  status                  ServiceStatus            @default(OPERATIONAL)
  createdAt               DateTime                 @default(now())
  transactions            Transaction[]
  destinationTransactions Transaction[]            @relation("DestinationInstitution")
  incidents               IncidentInstitution[]
  anomalies               Anomaly[]
  ledgerEntries           InstitutionLedgerEntry[]
  settlements             Settlement[]
  reconciliationRuns      ReconciliationRun[]

  @@index([status])
}

model Merchant {
  id           String        @id @default(cuid())
  name         String
  code         String        @unique
  category     String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  anomalies    Anomaly[]
}

model Transaction {
  id                       String                  @id @default(cuid())
  transactionId            String                  @unique
  customerId               String
  merchantId               String
  merchant                 Merchant                @relation(fields: [merchantId], references: [id])
  merchantReference        String?
  institutionId            String
  institution              Institution             @relation(fields: [institutionId], references: [id])
  destinationInstitutionId String?
  destinationInstitution   Institution?            @relation("DestinationInstitution", fields: [destinationInstitutionId], references: [id])
  amount                   Decimal                 @db.Decimal(14, 2)
  currency                 String                  @default("NPR")
  paymentMethod            PaymentMethod
  serviceKey               String                  @default("payment-api")
  status                   TxStatus
  lifecycleStage           String                  @default("COMPLETED")
  responseCode             String?
  responseTimeMs           Int
  riskScore                Int
  failureReason            FailureReason?
  settlementStatus         SettlementStatus        @default(NOT_STARTED)
  settlementId             String?
  settlement               Settlement?             @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  notificationStatus       DeliveryState           @default(PENDING)
  correlationId            String
  apiEndpoint              String
  suspicious               Boolean                 @default(false)
  initiatedAt              DateTime?
  authenticatedAt          DateTime?
  processedAt              DateTime?
  completedAt              DateTime?
  settledAt                DateTime?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  events                   TransactionEvent[]
  ledgerEntry              InstitutionLedgerEntry?

  @@index([createdAt])
  @@index([status])
  @@index([institutionId])
  @@index([merchantId])
  @@index([amount])
  @@index([createdAt, status])
  @@index([institutionId, createdAt])
  @@index([suspicious])
  @@index([correlationId])
  @@index([settlementStatus])
  @@index([settlementId])
}

model TransactionEvent {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  service       String
  event         String
  status        String
  createdAt     DateTime

  @@index([transactionId, createdAt])
}

/// Simulated institution-side ledger. Reconciliation compares it against platform transactions and settlements.
model InstitutionLedgerEntry {
  id             String       @id @default(cuid())
  institutionId  String
  institution    Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  transactionRef String
  transactionId  String?      @unique
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  amount         Decimal      @db.Decimal(14, 2)
  status         String
  recordedAt     DateTime

  @@index([institutionId, recordedAt])
  @@index([recordedAt])
  @@index([transactionRef])
}

model Settlement {
  id               String                @id @default(cuid())
  publicId         String                @unique
  institutionId    String
  institution      Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  status           SettlementBatchStatus @default(PENDING)
  transactionCount Int
  amount           Decimal               @db.Decimal(16, 2)
  expectedAt       DateTime?
  settledAt        DateTime?
  jobId            String?
  createdAt        DateTime              @default(now())
  transactions     Transaction[]

  @@index([createdAt])
  @@index([status])
}

model ReconciliationRun {
  id                   String               @id @default(cuid())
  publicId             String               @unique
  windowFrom           DateTime
  windowTo             DateTime
  institutionId        String?
  institution          Institution?         @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  status               ReconStatus
  expectedCount        Int
  actualCount          Int
  matchedCount         Int
  unmatchedCount       Int
  expectedAmount       Decimal              @db.Decimal(16, 2)
  actualAmount         Decimal              @db.Decimal(16, 2)
  difference           Decimal              @db.Decimal(16, 2)
  settledCount         Int                  @default(0)
  settledAmount        Decimal              @default(0) @db.Decimal(16, 2)
  settlementDifference Decimal              @default(0) @db.Decimal(16, 2)
  notes                String?
  createdById          String?
  createdBy            User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  jobId                String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  items                ReconciliationItem[]

  @@index([createdAt])
  @@index([status])
}

model ReconciliationItem {
  id                String            @id @default(cuid())
  runId             String
  run               ReconciliationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  transactionRef    String
  institutionId     String?
  issue             ReconIssue
  platformAmount    Decimal?          @db.Decimal(14, 2)
  institutionAmount Decimal?          @db.Decimal(14, 2)
  createdAt         DateTime          @default(now())

  @@index([runId])
}

model OperationalJob {
  id                String    @id @default(cuid())
  publicId          String    @unique
  type              JobType
  status            JobStatus @default(QUEUED)
  startedAt         DateTime?
  finishedAt        DateTime?
  durationMs        Int?
  recordsProcessed  Int       @default(0)
  successfulRecords Int       @default(0)
  failedRecords     Int       @default(0)
  triggeredBy       String
  output            Json?
  error             String?
  createdAt         DateTime  @default(now())

  @@index([createdAt])
  @@index([type, status])
}

model DataQualityIssue {
  id            String    @id @default(cuid())
  publicId      String    @unique
  type          DqType    @unique
  title         String
  description   String
  affectedCount Int       @default(0)
  status        DqStatus  @default(OPEN)
  note          String?
  detectedAt    DateTime  @default(now())
  lastCheckedAt DateTime  @default(now())
  resolvedAt    DateTime?
  updatedAt     DateTime  @updatedAt
}

model Service {
  id             String              @id @default(cuid())
  key            String              @unique
  name           String
  description    String?
  layer          String?
  status         ServiceStatus       @default(OPERATIONAL)
  responseTimeMs Int                 @default(120)
  errorRate      Float               @default(0)
  uptime         Float               @default(99.99)
  lastCheckedAt  DateTime            @default(now())
  cpu            Float               @default(22)
  memory         Float               @default(41)
  simulated      Boolean             @default(true)
  apiEndpoints   ApiEndpoint[]
  incidents      IncidentService[]
  dependsOn      ServiceDependency[] @relation("DependencyFrom")
  dependents     ServiceDependency[] @relation("DependencyTo")
}

model ServiceDependency {
  id            String  @id @default(cuid())
  fromServiceId String
  toServiceId   String
  fromService   Service @relation("DependencyFrom", fields: [fromServiceId], references: [id], onDelete: Cascade)
  toService     Service @relation("DependencyTo", fields: [toServiceId], references: [id], onDelete: Cascade)

  @@unique([fromServiceId, toServiceId])
}

/// Demo API endpoint registry. Aggregates are recomputed from ApiCall rows.
model ApiEndpoint {
  id           String        @id @default(cuid())
  serviceId    String
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String        @default("")
  endpoint     String
  method       String
  status       ServiceStatus @default(OPERATIONAL)
  latencyMs    Int
  rpm          Int
  errorRate    Float
  p50Ms        Int           @default(0)
  p95Ms        Int
  p99Ms        Int
  availability Float
  updatedAt    DateTime      @updatedAt
  calls        ApiCall[]

  @@unique([method, endpoint])
  @@map("ApiMetric")
}

model ApiCall {
  id             String      @id @default(cuid())
  endpointId     String
  endpoint       ApiEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  statusCode     Int
  latencyMs      Int
  institutionId  String?
  transactionRef String?
  createdAt      DateTime    @default(now())

  @@index([endpointId, createdAt])
  @@index([createdAt])
}

model SystemMetric {
  id               String   @id @default(cuid())
  recordedAt       DateTime @default(now())
  cpu              Float
  memory           Float
  dbConnections    Int
  redisUp          Boolean
  queueLength      Int
  healthScore      Int
  storageMb        Float    @default(0)
  slowQueries      Int      @default(0)
  replicationLagMs Int      @default(0)
  cacheUsagePct    Float    @default(0)
  processMemoryMb  Float    @default(0)
  eventLoopLagMs   Float    @default(0)
  simulated        Boolean  @default(true)

  @@index([recordedAt])
}

model Incident {
  id                       String                @id @default(cuid())
  publicId                 String                @unique
  title                    String
  description              String
  severity                 IncidentSeverity
  status                   IncidentStatus
  incidentType             String
  team                     String?
  scenario                 String?
  affectedTransactionCount Int                   @default(0)
  rootCause                String?
  rootCauseConfirmed       Boolean               @default(false)
  resolution               String?
  preventiveAction         String?
  aiSummary                String?
  rca                      Json?
  reopenCount              Int                   @default(0)
  detectedAt               DateTime
  acknowledgedAt           DateTime?
  resolvedAt               DateTime?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  assigneeId               String?
  assignee                 User?                 @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  events                   IncidentEvent[]
  institutions             IncidentInstitution[]
  services                 IncidentService[]
  anomalies                Anomaly[]

  @@index([status])
  @@index([incidentType])
  @@index([createdAt])
  @@index([severity])
}

model IncidentEvent {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  kind       String   @default("EVENT")
  message    String
  actorEmail String?
  createdAt  DateTime @default(now())

  @@index([incidentId, createdAt])
}

model IncidentInstitution {
  incidentId    String
  institutionId String
  incident      Incident    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@id([incidentId, institutionId])
}

model IncidentService {
  incidentId String
  serviceId  String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([incidentId, serviceId])
}

model Anomaly {
  id            String           @id @default(cuid())
  publicId      String           @unique
  type          AnomalyType
  severity      IncidentSeverity
  status        AnomalyStatus    @default(DETECTED)
  score         Float
  title         String
  description   String
  method        String
  entityType    String?
  entityName    String?
  normalValue   Float?
  observedValue Float?
  institutionId String?
  institution   Institution?     @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  merchantId    String?
  merchant      Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  incidentId    String?
  incident      Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  evidence      Json?
  decisionNote  String?
  reviewedById  String?
  reviewer      User?            @relation("AnomalyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  detectedAt    DateTime         @default(now())
  reviewedAt    DateTime?
  resolvedAt    DateTime?
  createdAt     DateTime         @default(now())

  @@index([status])
  @@index([type])
  @@index([detectedAt])
}

model Report {
  id             String     @id @default(cuid())
  type           ReportType
  title          String
  dateFrom       DateTime
  dateTo         DateTime
  payload        Json
  deliveryStatus String     @default("GENERATED")
  createdById    String?
  createdBy      User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime   @default(now())

  @@index([createdAt])
  @@index([type])
}

model ReportSchedule {
  id             String        @id @default(cuid())
  cadence        ReportCadence @unique
  enabled        Boolean       @default(false)
  reportType     ReportType    @default(DAILY_OPERATIONS)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  deliveryStatus String        @default("EMAIL_DISABLED")
  updatedAt      DateTime      @updatedAt
}

model AuditLog {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorEmail    String
  action        String
  resource      String
  resourceId    String?
  ipAddress     String?
  userAgent     String?
  previousValue Json?
  newValue      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([userId])
  @@index([resource])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  severity  String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  tool           String?
  actions        Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

/// Log of every assistant and Ask Your Data request, including the structured query that was executed.
model AiQuery {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  kind            String
  question        String
  intent          String?
  structuredQuery Json?
  resultCount     Int?
  status          String
  durationMs      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model SimulatorConfig {
  id                String    @id @default("default")
  running           Boolean   @default(false)
  tpm               Int       @default(60)
  successRate       Float     @default(0.94)
  failureRate       Float     @default(0.04)
  pendingRate       Float     @default(0.02)
  highValueRate     Float     @default(0.01)
  anomalyRate       Float     @default(0.01)
  averageAmount     Int       @default(3500)
  scenario          String?
  scenarioIntensity Float     @default(1)
  scenarioStartedAt DateTime?
  updatedAt         DateTime  @updatedAt
}

model ThresholdConfig {
  id                       String   @id @default("default")
  highValueAmount          Int      @default(100000)
  failureRatePct           Float    @default(5)
  latencyMs                Int      @default(5000)
  availabilityPct          Float    @default(95)
  volumeAnomalyPct         Float    @default(80)
  repeatedFailureCount     Int      @default(8)
  dedupWindowMinutes       Int      @default(60)
  rpmGate                  Int      @default(40)
  consecutiveLatencyChecks Int      @default(5)
  updatedAt                DateTime @updatedAt
}

model IdempotencyKey {
  key       String   @id
  method    String
  path      String
  status    Int
  body      Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
